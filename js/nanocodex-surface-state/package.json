{
  "name": "nanocodex-surface-state",
  "version": "0.1.0",
  "private": true,
  "description": "Shared surface-state reducer and card projection (JavaScript mirror of crates/nanocodex-surface-state)",
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./html": {
      "types": "./html.d.mts",
      "import": "./html.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "html.mjs",
    "html.d.mts",
    "styles.css",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && tsc -p test/tsconfig.json",
    "render:fixtures": "node scripts/render-fixtures.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gakonst/nanocodex.git",
    "directory": "js/nanocodex-surface-state"
  }
}
